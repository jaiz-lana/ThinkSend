{
  "name": "thinksend",
  "private": true,
  "version": "0.4.3",
  "description": "Aplikasi web PWA untuk transfer file cepat lintas jalur (QR Optik, WLAN, Provider P2P) dengan tema terang Telegram dan motif Batik Parang.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "audit:deps": "npm audit --omit=dev"
  },
  "dependencies": {
    "@noble/secp256k1": "^3.2.0",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^5.1.1"
  }
}
